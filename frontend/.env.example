# Backend API URL (server-side, for API proxy routes)
BACKEND_URL=http://localhost:3000

# Site Password (for early access lock - set your own secure password)
SITE_PASSWORD=your-secure-password-here

# Public API URL (client-side)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Stripe Public Key
NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Polygon Chain ID (137 for mainnet, 80001 for Mumbai testnet)
NEXT_PUBLIC_CHAIN_ID=137

# Encryption key for API keys stored in database (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-key-here
